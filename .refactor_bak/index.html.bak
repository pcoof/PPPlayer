<!DOCTYPE html>
<html lang="zh-CN" class="dark">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<meta name="theme-color" content="#b0823c">
<title>TSPlayer</title>
<link rel="stylesheet" href="/static/css/utilities.css">
<link rel="stylesheet" href="/static/css/style.css">
<script src="/static/js/alpine.min.js" defer></script>
</head>

<body class="bg-paper text-ink min-h-screen antialiased" x-data="app()" x-init="init()" :class="{'overflow-hidden':showPlayer||showSettings||showFav||showHist}">

<!-- 顶栏（自定义标题栏：可拖拽，含窗口控制） -->
<header id="titleBar" class="ts-header sticky top-0 z-30" @mousedown="titleBarMouseDown" @dblclick="titleBarDblClick">
  <div class="ts-toprow">
    <div class="ts-container py-3 flex items-center gap-4 justify-between">
      <a href="#" @click.prevent="page=1;currentType='0';loadData()" class="ts-wordmark shrink-0">TS<span class="dot">.</span>Player</a>
      <div class="ts-search-wrap">
        <div class="ts-search relative flex items-center pl-4 pr-1.5 py-1">
          <svg class="w-[18px] h-[18px] text-ink-3 shrink-0" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          <input type="text" x-model="searchWd" @keydown.enter="doSearch()" @focus="showSearchHist=true" @blur="setTimeout(()=>showSearchHist=false,200)" placeholder="搜索影片、剧集、演员…" class="ts-search-input flex-1 px-3 bg-transparent border-0 outline-none text-sm">
          <button @click="doSearch()" class="ts-search-btn shrink-0">搜索</button>

          <div x-show="showSearchHist && searchHistory.length" x-cloak class="ts-dropdown absolute z-50 top-full left-0 right-0 mt-2 p-1.5">
            <template x-for="term in searchHistory.slice(0,6)" :key="term">
              <div class="ts-dropdown-item flex items-center justify-between px-3 py-2 rounded-lg">
                <button @click="searchWd=term;doSearch()" class="flex items-center gap-2.5 text-xs text-ink-2 flex-1 text-left">
                  <svg class="w-4 h-4 text-ink-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span x-text="term" class="truncate"></span>
                </button>
                <button @click="removeSearchHistory(term)" class="p-1 text-ink-3 hover:text-danger transition-colors" title="删除">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
              </div>
            </template>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <button @click="toggleThemeMode()" class="ts-icon-btn" :title="'主题：' + cfg.theme">
          <template x-if="cfg.theme==='light'"><svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-1.414-1.414M6.343 6.343 4.93 4.93m12.728 1.414L16.242 7.76M6.343 17.657l-1.414 1.414M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg></template>
          <template x-if="cfg.theme==='dark'"><svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></template>
          <template x-if="cfg.theme==='auto'"><svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></template>
        </button>
        <button @click="showFav=!showFav;showHist=false;showSettings=false" class="ts-icon-btn relative" :class="showFav?'is-active':''" title="收藏">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          <span x-show="fav.length" x-cloak x-text="fav.length" class="ts-badge"></span>
        </button>
        <button @click="showHist=!showHist;showFav=false;showSettings=false" class="ts-icon-btn relative" :class="showHist?'is-active':''" title="历史">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span x-show="his.length" x-cloak x-text="his.length" class="ts-badge"></span>
        </button>
        <button @click="showSettings=!showSettings;showFav=false;showHist=false" class="ts-icon-btn" :class="showSettings?'is-active':''" title="设置">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </button>
      </div>
    </div>
    <div class="ts-win-controls header-win" @mousedown.stop>
      <button class="ts-win-btn" @click="winMin" title="最小化" aria-label="最小化">
        <svg width="13" height="13" viewBox="0 0 13 13"><rect x="2" y="6.2" width="9" height="1.5" rx="0.75" fill="currentColor"/></svg>
      </button>
      <button class="ts-win-btn" @click="winMax" title="最大化 / 还原" aria-label="最大化">
        <svg width="13" height="13" viewBox="0 0 13 13"><rect x="2" y="2" width="9" height="9" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
      <button class="ts-win-btn ts-win-close" @click="winClose" title="关闭" aria-label="关闭">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 3l7 7M10 3l-7 7" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div id="typeNavContainer" x-show="classes.length" x-cloak class="ts-catnav">
    <div class="ts-container py-1.5">
      <div class="flex items-center gap-1 py-2">
        <button @click="currentType='0';page=1;loadData()" class="ts-cat" :class="currentType==='0'?'is-active':''">全部</button>
        <template x-for="c in visibleClasses" :key="c.type_id">
          <button @click="currentType=String(c.type_id);page=1;loadData()" class="ts-cat" :class="currentType===String(c.type_id)?'is-active':''" x-text="c.type_name"></button>
        </template>
        <div x-show="hiddenClasses.length > 0" class="relative ml-1">
          <button @click="showMoreTypes=!showMoreTypes" class="ts-cat-more flex items-center" title="更多分类">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <div x-show="showMoreTypes" x-cloak x-transition @click.away="showMoreTypes=false" class="ts-cat-menu absolute right-0 top-full mt-2 w-48 p-1.5 z-50 max-h-64 overflow-y-auto ts-scroll">
            <template x-for="c in hiddenClasses" :key="c.type_id">
              <button @click="currentType=String(c.type_id);page=1;loadData();showMoreTypes=false" class="block w-full text-left px-3 py-2 rounded-lg text-sm text-ink-2 hover:bg-surface-2 transition-colors" x-text="c.type_name"></button>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- 主内容 -->
<main class="flex-1 ts-container ts-content py-7">
  <!-- 空状态：无源 -->
  <div x-show="!sources.length" x-cloak class="ts-empty">
    <div class="ts-empty-icon">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
    </div>
    <h3>还没有添加影视源</h3>
    <p>在设置中添加 API 源，开始你的私人放映厅</p>
    <button @click="showSettings=true;settingsTab='sources'" class="ts-cta">去添加</button>
  </div>

  <!-- 加载 -->
  <div x-show="loading" x-cloak class="flex justify-center items-center py-24">
    <div class="ts-spinner"></div>
  </div>

  <!-- 卡片墙 -->
  <div x-show="videos.length" x-cloak :class="currentListLayout()==='poster' ? 'ts-grid-poster' : 'ts-grid-land'">
    <template x-for="item in videos" :key="item.vod_id + '_' + Math.random()">
      <div @click="openPlayer(item)" class="ts-card group">
        <div class="ts-card-media" :class="currentListLayout()==='poster' ? 'aspect-[2/3]' : 'aspect-[5/3]'">
          <img :src="item.vod_pic || placeholderImg" loading="lazy" @error="$event.target.src=placeholderImg" alt="">
          <div class="ts-card-gradient"></div>
          <span x-show="cardTagText('tl', item)" x-cloak x-text="cardTagText('tl', item)" class="ts-tag top-2.5 left-2.5"></span>
          <span x-show="cardTagText('tr', item)" x-cloak x-text="cardTagText('tr', item)" class="ts-tag top-2.5 right-12"></span>
          <span x-show="cardTagText('bl', item)" x-cloak x-text="cardTagText('bl', item)" class="ts-tag bottom-2.5 left-2.5"></span>
          <span x-show="cardTagText('br', item)" x-cloak x-text="cardTagText('br', item)" class="ts-tag bottom-2.5 right-2.5"></span>
          <button @click.stop="toggleFav(item)" class="ts-fav-btn" :class="isFav(item.vod_id)?'is-fav':''" title="收藏">
            <svg :class="isFav(item.vod_id)?'fill-current':''" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </button>
        </div>
        <div class="ts-card-body">
          <h3 class="ts-card-title" x-text="item.vod_name || '未命名'"></h3>
          <div class="ts-card-meta flex items-center gap-2">
            <span x-show="cardTagText('sub1', item)" x-cloak x-text="cardTagText('sub1', item)"></span>
            <span x-show="cardTagText('sub2', item)" x-cloak x-text="cardTagText('sub2', item)"></span>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- 分页 -->
  <div x-show="totalPages>1 && cfg.loadMode==='page'" x-cloak class="flex justify-center items-center gap-2 mt-10 pb-4">
    <button @click="page>1&&(page--,loadData())" class="ts-ghost-btn" :class="page<=1?'opacity-50 cursor-not-allowed':''">上一页</button>
    <template x-for="p in pageRange()" :key="p">
      <button @click="page=p;loadData()" class="ts-seg"><span class="ts-seg-btn" :class="p===page?'is-active':''" x-text="p" style="padding:8px 14px;border-radius:10px;font-size:13px"></span></button>
    </template>
    <button @click="page<totalPages&&(page++,loadData())" class="ts-ghost-btn" :class="page>=totalPages?'opacity-50 cursor-not-allowed':''">下一页</button>
  </div>

  <!-- 瀑布流加载更多（手动兜底按钮：滚动自动加载为主，按钮始终可用作补充；加载中显示转圈动画） -->
  <div x-show="videos.length && page < totalPages && cfg.loadMode==='waterfall'" x-cloak class="loadMore flex justify-center items-center mt-8 pb-4">
    <button x-show="!loading" @click="loadMore()" class="ts-ghost-btn !py-3 !px-8">加载更多</button>
    <div x-show="loading" class="loading loading-14" role="status" aria-label="加载中"></div>
  </div>
  <div id="loadSentinel" style="height:1px"></div>

  <!-- 空数据 -->
  <div x-show="sources.length && !loading && !videos.length" x-cloak class="ts-empty">
    <div class="ts-empty-icon">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" /></svg>
    </div>
    <h3>暂无影片</h3>
    <p>换个分类或调整关键词试试</p>
  </div>
</main>

<!-- 收藏抽屉 -->
<div x-show="showFav" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-6" x-transition:enter-end="opacity-100 translate-x-0" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" @click.away="showFav=false" class="fixed inset-y-0 right-0 z-40 w-[420px] max-w-full ts-drawer ts-scroll">
  <div class="ts-drawer-head">
    <h2 class="ts-drawer-title">我的收藏</h2>
    <button @click="showFav=false" class="ts-icon-btn"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
  </div>
  <div class="flex-1 overflow-y-auto px-3 py-3 space-y-1.5 ts-scroll">
    <template x-for="item in fav" :key="item.vod_id">
      <div @click="openPlayer(item);showFav=false" class="ts-list-item">
        <img :src="item.vod_pic || placeholderImg" class="ts-list-thumb" @error="$event.target.src=placeholderImg">
        <div class="flex-1 min-w-0">
          <h4 class="ts-list-title truncate" x-text="item.vod_name"></h4>
          <p class="ts-list-sub" x-text="item.type_name || ''"></p>
        </div>
        <button @click.stop="toggleFav(item)" class="p-2 text-danger hover:bg-danger-soft rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        </button>
      </div>
    </template>
    <div x-show="!fav.length" x-cloak class="text-center py-16 text-sm text-ink-3">还没有收藏</div>
  </div>
</div>

<!-- 历史抽屉 -->
<div x-show="showHist" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-6" x-transition:enter-end="opacity-100 translate-x-0" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" @click.away="showHist=false" class="fixed inset-y-0 right-0 z-40 w-[420px] max-w-full ts-drawer ts-scroll">
  <div class="ts-drawer-head">
    <h2 class="ts-drawer-title">播放历史</h2>
    <div class="flex items-center gap-2">
      <button @click="clearHist()" class="ts-danger-text px-3 py-1.5 text-xs rounded-lg hover:bg-danger-soft transition-colors">清空</button>
      <button @click="showHist=false" class="ts-icon-btn"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
    </div>
  </div>
  <div class="flex-1 overflow-y-auto px-3 py-3 space-y-1.5 ts-scroll">
    <template x-for="item in his" :key="item.vod_id + '_' + item.last_watch_time">
      <div @click="openPlayer(item);showHist=false" class="ts-list-item">
        <img :src="item.vod_pic || placeholderImg" class="ts-list-thumb" @error="$event.target.src=placeholderImg">
        <div class="flex-1 min-w-0">
          <h4 class="ts-list-title truncate" x-text="item.vod_name"></h4>
          <p class="ts-list-sub" x-text="formatTime(item.last_watch_time)"></p>
        </div>
      </div>
    </template>
    <div x-show="!his.length" x-cloak class="text-center py-16 text-sm text-ink-3">还没有历史</div>
  </div>
</div>

<!-- 设置抽屉 -->
<div x-show="showSettings" x-cloak x-transition.opacity @click.self="showSettings=false" class="fixed inset-0 z-50 ts-modal-scrim flex items-start justify-end">
  <div @click.stop x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-8" x-transition:enter-end="opacity-100 translate-x-0" class="fixed inset-y-0 right-0 z-50 w-[480px] max-w-full ts-drawer ts-scroll">
    <div class="ts-drawer-head">
      <h2 class="ts-drawer-title">设置中心</h2>
      <button @click="showSettings=false" class="ts-icon-btn"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
    </div>
    <div class="flex px-3 py-2 gap-1 bg-surface-2 border-b border-line">
      <button @click="settingsTab='basic'" class="ts-tab" :class="settingsTab==='basic'?'is-active':''">基础</button>
      <button @click="settingsTab='layout'" class="ts-tab" :class="settingsTab==='layout'?'is-active':''">布局</button>
      <button @click="settingsTab='sources'" class="ts-tab" :class="settingsTab==='sources'?'is-active':''">API源</button>
      <button @click="settingsTab='data'" class="ts-tab" :class="settingsTab==='data'?'is-active':''">数据</button>
    </div>
    <div class="flex-1 overflow-y-auto px-5 space-y-6 ts-scroll">
      <!-- 基础 -->
      <div x-show="settingsTab==='basic'" x-cloak class="space-y-5">
        <div>
          <label class="ts-label block mb-2">加载模式</label>
          <div class="ts-seg">
            <button @click="cfg.loadMode='page';saveCfg();setupAutoLoad()" :class="cfg.loadMode==='page'?'is-active':''">上下页</button>
            <button @click="cfg.loadMode='waterfall';saveCfg();setupAutoLoad()" :class="cfg.loadMode==='waterfall'?'is-active':''">瀑布流</button>
          </div>
        </div>
      </div>
      <!-- 布局 -->
      <div x-show="settingsTab==='layout'" x-cloak class="space-y-6">
        <div>修改后同步到当前选择的api源</div>
        <div>
          <label class="ts-label block mb-2">海报比例</label>
          <div class="ts-seg">
            <button @click="setListLayout('poster')" :class="currentListLayout()==='poster'?'is-active':''">竖图</button>
            <button @click="setListLayout('landscape')" :class="currentListLayout()==='landscape'?'is-active':''">横图</button>
          </div>
        </div>
        <div>
          <label class="ts-label block mb-2">卡片标签</label>
          <p class="ts-hint mb-3">四角标签与标题下方两行，从字段中选择（选「不显示」则隐藏）</p>
          <div class="grid grid-cols-2 gap-3">
            <div><span class="ts-hint block mb-1">左上角</span><select @change="setCardTag('tl', $event.target.value)" :value="activeCardTags().tl" class="ts-select"><option value="">不显示</option><option value="type">分类</option><option value="hits">热度</option><option value="lang">语言</option><option value="year">年代</option><option value="area">地区</option><option value="actor">演员</option><option value="director">导演</option><option value="tag">标签</option><option value="duration">时长</option><option value="state">资源类别</option><option value="remarks">备注</option><option value="pubdate">上映日期</option></select></div>
            <div><span class="ts-hint block mb-1">右上角</span><select @change="setCardTag('tr', $event.target.value)" :value="activeCardTags().tr" class="ts-select"><option value="">不显示</option><option value="type">分类</option><option value="hits">热度</option><option value="lang">语言</option><option value="year">年代</option><option value="area">地区</option><option value="actor">演员</option><option value="director">导演</option><option value="tag">标签</option><option value="duration">时长</option><option value="state">资源类别</option><option value="remarks">备注</option><option value="pubdate">上映日期</option></select></div>
            <div><span class="ts-hint block mb-1">左下角</span><select @change="setCardTag('bl', $event.target.value)" :value="activeCardTags().bl" class="ts-select"><option value="">不显示</option><option value="type">分类</option><option value="hits">热度</option><option value="lang">语言</option><option value="year">年代</option><option value="area">地区</option><option value="actor">演员</option><option value="director">导演</option><option value="tag">标签</option><option value="duration">时长</option><option value="state">资源类别</option><option value="remarks">备注</option><option value="pubdate">上映日期</option></select></div>
            <div><span class="ts-hint block mb-1">右下角</span><select @change="setCardTag('br', $event.target.value)" :value="activeCardTags().br" class="ts-select"><option value="">不显示</option><option value="type">分类</option><option value="hits">热度</option><option value="lang">语言</option><option value="year">年代</option><option value="area">地区</option><option value="actor">演员</option><option value="director">导演</option><option value="tag">标签</option><option value="duration">时长</option><option value="state">资源类别</option><option value="remarks">备注</option><option value="pubdate">上映日期</option></select></div>
            <div><span class="ts-hint block mb-1">标题下方·第一行</span><select @change="setCardTag('sub1', $event.target.value)" :value="activeCardTags().sub1" class="ts-select"><option value="">不显示</option><option value="type">分类</option><option value="hits">热度</option><option value="lang">语言</option><option value="year">年代</option><option value="area">地区</option><option value="actor">演员</option><option value="director">导演</option><option value="tag">标签</option><option value="duration">时长</option><option value="state">资源类别</option><option value="remarks">备注</option><option value="pubdate">上映日期</option></select></div>
            <div><span class="ts-hint block mb-1">标题下方·第二行</span><select @change="setCardTag('sub2', $event.target.value)" :value="activeCardTags().sub2" class="ts-select"><option value="">不显示</option><option value="type">分类</option><option value="hits">热度</option><option value="lang">语言</option><option value="year">年代</option><option value="area">地区</option><option value="actor">演员</option><option value="director">导演</option><option value="tag">标签</option><option value="duration">时长</option><option value="state">资源类别</option><option value="remarks">备注</option><option value="pubdate">上映日期</option></select></div>
          </div>
        </div>
      </div>
      <!-- API 源 -->
      <div x-show="settingsTab==='sources'" x-cloak class="space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="ts-label">API 源（单选）</h3>
          <div class="flex items-center gap-2">
            <button @click="checkAllSources()" class="ts-ghost-btn">检测全部</button>
            <button @click="exportSources()" class="ts-ghost-btn">导出</button>
            <button @click="$refs.importFile.click()" class="ts-ghost-btn">导入</button>
            <input type="file" x-ref="importFile" @change="importSources($event)" accept=".json" class="hidden">
          </div>
        </div>
        <div class="space-y-2">
          <button @click="addSource()" class="ts-add-dashed">＋ 添加 API 源</button>
          <template x-for="(s,i) in sources" :key="s.id">
            <div class="ts-src" :class="!s.enabled?'off':''">
              <button @click="setActiveSource(i)" class="ts-switch" :class="s.enabled?'on':''"><span></span></button>
              <div class="flex-1 min-w-0" style="width: 70%;">
                <div class="ts-src-name"><span :class="getStatusColor(s)" class="ts-status-dot mr-1">●</span><span x-text="s.name"></span></div>
                <div class="ts-src-url" x-text="s.url"></div>
              </div>
              <button @click="checkSourceStatus(i)" class="ts-icon-btn" title="检测连接">
                <svg viewBox="0 0 1024 1024" width="18" height="18"><path d="M884.565333 387.413333a32 32 0 0 1-32 32h-245.333333v-64h180.650667c-36.010667-49.237333-75.733333-88.064-133.632-117.504a309.333333 309.333333 0 1 0 166.613333 315.989334l4.138667-31.744 63.445333 8.32-4.181333 31.744a373.376 373.376 0 0 1-371.2 324.821333 373.333333 373.333333 0 1 1 170.154666-706.176c58.752 29.866667 101.333333 67.925333 137.386667 112.170667V142.08h64v245.333333z" fill="#051531"></path></svg>
              </button>
              <button @click="editSource(i)" class="ts-icon-btn" title="编辑">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
              </button>
              <button @click="deleteSource(i)" class="ts-icon-btn ts-danger-text" title="删除">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          </template>
        </div>
      </div>
      <!-- 数据 -->
      <div x-show="settingsTab==='data'" x-cloak class="space-y-5">
        <div>
          <label class="ts-label block mb-2">全局数据</label>
          <p class="ts-hint mb-3">导出含设置、源、收藏、历史与搜索记录；导入将覆盖当前全部本地数据。</p>
          <div class="ts-seg">
            <button @click="exportAllData()" class="ts-ghost-btn">导出全部</button>
            <button @click="$refs.importAllFile.click()" class="ts-ghost-btn">导入全部</button>
            <input type="file" x-ref="importAllFile" @change="importAllData($event)" accept=".json" class="hidden">
          </div>
        </div>
        <div>
          <label class="ts-label block mb-2">API 源</label>
          <div class="ts-seg">
            <button @click="exportSources()" class="ts-ghost-btn">导出源</button>
            <button @click="$refs.importFile2.click()" class="ts-ghost-btn">导入源</button>
            <input type="file" x-ref="importFile2" @change="importSources($event)" accept=".json" class="hidden">
          </div>
        </div>
        <div class="ts-info-note">
          <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
          <div>
            <p class="ts-info-note-t">数据存储说明</p>
            <p class="d">配置保存在本地 <code>data/config.json</code>，卸载前请导出备份。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 源编辑模态 -->
<div x-show="showSourceEdit" x-cloak x-transition.opacity @click.self="showSourceEdit=false" class="fixed inset-0 z-50 ts-modal-scrim flex items-start justify-center pt-12 px-4">
  <div @click.stop x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4" x-transition:enter-end="opacity-100 translate-y-0" class="ts-modal">
    <h3 class="ts-modal-title px-6 py-4 border-b border-line" x-text="editingIdx===null?'添加 API 源':'编辑 API 源'"></h3>
    <div class="px-6 py-5 space-y-4 ts-scroll overflow-y-auto max-h-[70vh]">
      <div>
        <label class="ts-label block mb-1.5">源名称</label>
        <input type="text" x-model="editingSource.name" placeholder="苹果CMS 源" class="ts-field">
      </div>
      <div>
        <label class="ts-label block mb-1.5">API 地址</label>
        <input type="text" x-model="editingSource.url" @input="fetchSourceClasses(editingSource.url)" placeholder="https://example.com/api.php/provide/vod/" class="ts-field">
        <p class="ts-hint mt-1.5">影视 CMS 的 api 填到 <code class="px-1 rounded bg-surface-2">/api.php/provide/vod/</code> 这一层</p>
      </div>
      <div>
        <label class="ts-label block mb-1.5">海报比例</label>
        <div class="ts-seg">
          <button type="button" @click="editingSource.listLayout='poster'" :class="(editingSource.listLayout||'poster')==='poster'?'is-active':''">竖图</button>
          <button type="button" @click="editingSource.listLayout='landscape'" :class="(editingSource.listLayout||'poster')==='landscape'?'is-active':''">横图</button>
        </div>
      </div>
      <div class="space-y-4 pt-1">
        <div>
          <p class="ts-label mb-3">本源跳过片头片尾（优先于全局）</p>
          <div class="flex items-center gap-4 mb-2">
            <label class="flex items-center gap-1.5 text-sm text-ink-2"><input type="checkbox" x-model="editingSource.skipIntro" class="rounded accent-accent"> 跳过片头</label>
            <div class="flex items-center gap-2 ml-6"><input type="number" min="0" x-model.number="editingSource.introTime" class="w-20 px-2 py-1.5 ts-field"><span class="text-sm text-ink-3">秒</span></div>
          </div>
          <div class="flex items-center gap-4 mb-2">
            <label class="flex items-center gap-1.5 text-sm text-ink-2"><input type="checkbox" x-model="editingSource.skipOutro" class="rounded accent-accent"> 跳过片尾</label>
            <div class="flex items-center gap-2 ml-6"><input type="number" min="0" x-model.number="editingSource.outroTime" class="w-20 px-2 py-1.5 ts-field"><span class="text-sm text-ink-3">秒(倒计时)</span></div>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between">
            <p class="ts-label">本源分类黑名单</p>
            <button @click="showSourceBlacklistPicker=!showSourceBlacklistPicker" type="button" class="ts-ghost-btn" x-text="showSourceBlacklistPicker ? '收起' : '展开选择'"></button>
          </div>
          <p class="ts-hint mb-2">勾选后该分类在本源下隐藏。</p>
          <div x-show="showSourceBlacklistPicker" x-cloak class="flex flex-wrap gap-1.5 mt-2">
            <div x-show="sourceClassesLoading" x-cloak class="text-sm text-ink-3 py-3">正在加载分类…</div>
            <div x-show="!sourceClassesLoading && (sourceClassesFetched.length || allClassesList.length)">
              <template x-for="c in (sourceClassesFetched.length ? sourceClassesFetched : allClassesList)" :key="c.type_id">
                <button @click="toggleSourceBlacklist(c)" type="button" class="ts-seg "><span class="ts-blacklist-chip " :class="isSourceBlacklisted(c)?'bg-red-500 text-white':''" x-text="c.type_name" style="padding:6px 12px;border-radius:9px;font-size:12.5px"></span></button>
              </template>
            </div>
            <p x-show="!sourceClassesLoading && !sourceClassesFetched.length && !allClassesList.length" x-cloak class="text-sm text-ink-3 py-3">请输入完整 API 地址以加载分类列表。</p>
          </div>
        </div>
      </div>
    </div>
    <div class="flex justify-end gap-3 px-6 py-4 border-t border-line">
      <button @click="showSourceEdit=false" class="ts-btn-ghost">取消</button>
      <button @click="saveSource()" class="ts-btn-primary">保存</button>
    </div>
  </div>
</div>
<script src="/static/js/api.js"></script>
<script src="/static/js/app.js"></script>
<script src="/static/js/window-chrome.js"></script>

  <!-- 无边框窗口：边缘缩放热区（仅窗口最外缘 6px）。按下时由 window-chrome.js 经 pywebview API 缩放 -->
  <div class="win-edge win-edge-n" data-hit="12"></div>
  <div class="win-edge win-edge-s" data-hit="15"></div>
  <div class="win-edge win-edge-w" data-hit="10"></div>
  <div class="win-edge win-edge-e" data-hit="11"></div>
  <div class="win-edge win-edge-nw" data-hit="13"></div>
  <div class="win-edge win-edge-ne" data-hit="14"></div>
  <div class="win-edge win-edge-sw" data-hit="16"></div>
  <div class="win-edge win-edge-se" data-hit="17"></div>
</body>

</html>
